{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edifis-data-analytics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "edifis-data-analytics"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "edifis-data-analytics",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "edifis-data-analytics"
        }
      ]
    },
    "preview": {
      "name": "edifis-data-analytics-preview",
      "workers_dev": true,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "edifis-data-analytics-preview"
        }
      ]
    }
  }
}
